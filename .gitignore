# ============================================================================
# Beat Scrobble - Project .gitignore
# ============================================================================

# ============================================================================
# IDE & Editors
# ============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================================
# Environment & Secrets
# ============================================================================
.env
.env.local
.env.*.local
*.env
secrets/
*.pem
*.key

# ============================================================================
# Docker - Local Overrides
# ============================================================================
docker-compose.dev.yml
docker-compose.prod.yml
docker-compose.local.yml
docker-compose.override.yml

# ============================================================================
# Scripts - Local Modifications
# ============================================================================
run.sh


# ============================================================================
# Go Backend
# ============================================================================
server/tmp/
server/build/
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin*

# ============================================================================
# Node.js / Frontend
# ============================================================================
node_modules/
client/node_modules/
client/.pnpm-store/
client/build/
client/dist/
client/.react-router/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ============================================================================
# Android / Mobile
# ============================================================================
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties
mobile/*.apk
mobile/*.aab
mobile/.idea/
android/
android-native/
local.properties
.gradle/

# ============================================================================
# Data & Volumes (Local Development)
# ============================================================================
data/
music/
config/
*.sqlite
*.sqlite3
*.db
*.tar
*.tar.gz

# ============================================================================
# Logs & Debugging
# ============================================================================
*.log
logs/
*.log.*
debug/

# ============================================================================
# Build Artifacts
# ============================================================================
dist/
build/
out/
*.o
*.a

# ============================================================================
# Testing
# ============================================================================
coverage/
.nyc_output/
*.test.js.map
__snapshots__/

# ============================================================================
# Misc
# ============================================================================
*.bak
*.tmp
*.temp
.cache/
.parcel-cache/

# ============================================================================
# Binaries & Temporary Scripts
# ============================================================================
beat-scrobble
beat_scrobble
newrun.sh
bin/
*.test
coverage.out
run.sh

# ============================================================================
# Android (beatscrobble-android)
# ============================================================================
# Built application files
beatscrobble-android/*.apk
beatscrobble-android/*.ap_
beatscrobble-android/*.aab

# Files for the ART/Dalvik VM
beatscrobble-android/*.dex

# Java class files
beatscrobble-android/**/*.class

# Generated files
beatscrobble-android/bin/
beatscrobble-android/gen/
beatscrobble-android/out/
beatscrobble-android/**/generated/

# Gradle files
beatscrobble-android/.gradle/
beatscrobble-android/build/
beatscrobble-android/**/build/

# Local configuration file (sdk.dir is shared by all users)
beatscrobble-android/local.properties

# Proguard folder generated by Eclipse
beatscrobble-android/proguard/

# Log Files
beatscrobble-android/*.log

# Android Studio Navigation editor temp files
beatscrobble-android/.navigation/

# Captures
beatscrobble-android/captures/

# IntelliJ / Android Studio
beatscrobble-android/.idea/
beatscrobble-android/*.iml
beatscrobble-android/*.ipr
beatscrobble-android/*.iws
beatscrobble-android/.cxx/
beatscrobble-android/.externalNativeBuild/

# Keystores
beatscrobble-android/*.jks
beatscrobble-android/*.keystore
beatscrobble-android/*.pem
beatscrobble-android/*.p12
beatscrobble-android/*.key

# Google Services
beatscrobble-android/**/google-services.json
